# --- WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; paste the same value in the webhook settings on Meta
WHATSAPP_VERIFY_TOKEN=
# App secret (App settings > Basic). Used to check that webhooks really come from Meta.
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# Only these numbers can use the bot (country code, digits only, comma separated). Leave empty to allow anyone.
ALLOWED_NUMBERS=919999999999

# --- Claude API (console.anthropic.com) ---
# Used to read PDFs/images/notes, sort questions into subjects and write questions from notes.
# Without it, only text that is already formatted as numbered MCQs can be imported.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Daily question ---
TIMEZONE=Asia/Kolkata
# Default time for new users (24h, HH:MM). Each user can change theirs with "daily 21:30".
DEFAULT_DAILY_TIME=07:00
# Approved message template used when the user hasn't messaged in 24h (WhatsApp rule).
# Leave empty to skip those users instead.
DAILY_TEMPLATE_NAME=
DAILY_TEMPLATE_LANG=en

# --- Server ---
PORT=3000
# Supabase > Project settings > Database > Connection string (use the "Session pooler" URI).
# Leave empty to use a local embedded database (data/pglite) for testing.
DATABASE_URL=
# true = print outgoing messages instead of sending them (safe for testing)
DRY_RUN=true
