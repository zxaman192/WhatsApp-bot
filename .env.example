# --- WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; paste the same value in the webhook settings on Meta
WHATSAPP_VERIFY_TOKEN=
# App secret (App settings > Basic). Used to check that webhooks really come from Meta.
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# Only these numbers can use the bot (country code, digits only, comma separated). Leave empty to allow anyone.
ALLOWED_NUMBERS=919999999999

# --- Telegram (optional second way to use the bot; shares the same database) ---
# Create a bot with @BotFather on Telegram and paste its token here.
TELEGRAM_BOT_TOKEN=
# Your Telegram user id. Message the bot once and it replies with your id. Empty = nobody can use it.
TELEGRAM_ALLOWED_IDS=
# Public https address of this server (Render sets RENDER_EXTERNAL_URL automatically, so leave empty there).
PUBLIC_URL=

# --- AI (optional): Gemini or Claude ---
# Without a key the bot still imports text/text PDFs laid out as MCQs and keeps other text as notes.
# claude | gemini | none. Empty = whichever key is set (Gemini first).
AI_PROVIDER=
# Free key, no card: aistudio.google.com > Get API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order when the main model runs out of free quota or is busy (each has its own daily quota).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest

# Claude (console.anthropic.com), pay per use.
ANTHROPIC_API_KEY=
# claude-haiku-5-5 is the cheapest. claude-sonnet-5-5 or claude-opus-5-5 read messy scans more accurately.
CLAUDE_MODEL=claude-haiku-5-5

# --- Daily question ---
TIMEZONE=Asia/Kolkata
# Default time for new users (24h, HH:MM). Each user can change theirs with "daily 21:30".
DEFAULT_DAILY_TIME=07:00
# Approved message template used when the user hasn't messaged in 24h (WhatsApp rule).
# Leave empty to skip those users instead.
DAILY_TEMPLATE_NAME=
DAILY_TEMPLATE_LANG=en

# --- Server ---
PORT=3000
# Supabase > Project settings > Database > Connection string (use the "Session pooler" URI).
# Leave empty to use a local embedded database (data/pglite) for testing.
DATABASE_URL=
# true = print outgoing WhatsApp messages instead of sending them (safe for testing)
DRY_RUN=true
# Same for Telegram (off by default: the bot only answers people who message it)
TELEGRAM_DRY_RUN=false
